# Copy to .env  (Prisma + Next + Auth.js all read it automatically)

# --- Database -----------------------------------------------------------------
# For a bare-Node run, set the full connection string:
DATABASE_URL="postgresql://circle:circle@localhost:5432/circle?schema=public"
# For docker compose, set these instead (compose builds DATABASE_URL from them):
# POSTGRES_USER="circle"
POSTGRES_PASSWORD="change-me"
# POSTGRES_DB="circle"

# --- Auth --------------------------------------------------------------------
# Auth.js (v5) — REQUIRED. Generate one with: npx auth secret
AUTH_SECRET="replace-me"
# Public URL of the app (used for auth callbacks + invite links)
AUTH_URL="http://localhost:3000"
# Required when running behind a reverse proxy / in Docker
AUTH_TRUST_HOST="true"

# Registration mode: "invite" (default) requires an invite link for every
# account except the very first; "open" lets anyone sign up.
# SIGNUP_MODE="invite"
# One-time secret that authorises creating the first ADMIN (via the /sign-up
# form or POST /api/bootstrap). Only usable while the workspace has no members.
# Generate with: openssl rand -hex 24
BOOTSTRAP_SECRET=""
# Secret for scheduled internal jobs such as cycle burn-up snapshots.
# Generate independently from BOOTSTRAP_SECRET: openssl rand -hex 32
CRON_SECRET=""

# --- Attachments ------------------------------------------------------------
# Directory for uploaded files (default <cwd>/uploads; /app/uploads in the
# container — compose mounts a volume there).
# UPLOAD_DIR="/app/uploads"
# MAX_ATTACHMENT_BYTES="10485760"          # per-file (10 MiB)
# MAX_WORKSPACE_ATTACHMENT_BYTES="2147483648"   # per-workspace (2 GiB; 0 = no cap)

# Background refresh for Issues + Inbox (milliseconds; 0 disables interval
# polling, but window-focus refresh remains enabled).
# WORKSPACE_REFRESH_INTERVAL_MS="30000"

# --- Misc ------------------------------------------------------------------
# WEB_PORT="3000"
# Backup output directory for `pnpm backup` (default: ./backups)
# CIRCLE_BACKUP_DIR="/srv/backups/circle"
# Seed: password given to every demo user (default: "password")
# SEED_PASSWORD="password"

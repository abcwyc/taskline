# Copy to .env  (Prisma + Next + Auth.js all read it automatically)

# Postgres connection string
DATABASE_URL="postgresql://circle:circle@localhost:5432/circle?schema=public"

# Auth.js (v5) — REQUIRED. Generate one with: npx auth secret
AUTH_SECRET="replace-me"
# Public URL of the app (used for auth callbacks)
AUTH_URL="http://localhost:3000"
# Required when running behind a reverse proxy / in Docker
AUTH_TRUST_HOST="true"

# Seed: password given to every demo user (default: "password")
# SEED_PASSWORD="password"

# Registration: "open" (anyone can sign up) or "invite" (invite link required;
# the first-ever account still gets through to bootstrap the workspace).
# SIGNUP_MODE="open"

# Attachment storage: directory for uploaded files (default: <cwd>/uploads,
# /app/uploads in the container — mount a volume there). Max size in bytes.
# UPLOAD_DIR="/app/uploads"
# MAX_ATTACHMENT_BYTES="10485760"

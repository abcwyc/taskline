# Copy to circle/.env  (Prisma + Next both read .env automatically)
DATABASE_URL="postgresql://circle:circle@localhost:5432/circle?schema=public"

# Auth.js (v5)
AUTH_SECRET="replace-me"          # generate: npx auth secret
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"            # required when self-hosting behind a proxy

# Seed
# SEED_PASSWORD="password"        # password for every demo user (default: password)

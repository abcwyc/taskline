# Put this server behind your TLS terminator, or add your certificate settings.
# If another trusted proxy sits in front, replace $remote_addr with that proxy's
# trusted real-IP configuration. Do not pass an arbitrary client-supplied
# X-Forwarded-For header: the app uses its first address for throttling.

limit_req_zone $binary_remote_addr zone=taskline_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=taskline_write:10m rate=30r/m;

upstream taskline_web {
   server web:3000;
   keepalive 16;
}

server {
   listen 80;
   server_name taskline.example.com;
   client_max_body_size 12m;

   location ~ ^/(?:api/bootstrap|api/jobs/|api/auth/|sign-in|sign-up) {
      limit_req zone=taskline_auth burst=10 nodelay;
      proxy_pass http://taskline_web;
      include /etc/nginx/taskline-proxy-headers.conf;
   }

   location ~ ^/api/(?:invites|issues/[^/]+/attachments) {
      limit_req zone=taskline_write burst=20 nodelay;
      proxy_pass http://taskline_web;
      include /etc/nginx/taskline-proxy-headers.conf;
   }

   location / {
      proxy_pass http://taskline_web;
      include /etc/nginx/taskline-proxy-headers.conf;
   }
}
